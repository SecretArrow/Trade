{
  "name": "trade",
  "version": "1.0.0",
  "private": true,
  "description": "TradingView-style charting terminal with indicators, drawing tools and multi-provider market data",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @trade/web dev",
    "build": "pnpm --filter @trade/web build",
    "preview": "pnpm --filter @trade/web preview",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .github/prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .github/prettierignore",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter './packages/*' --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "prettier": "^3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
