{
  "ci": {
    "collect": {
      "staticDistDir": "apps/web/dist",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.6 }],
        "categories:accessibility": ["error", { "minScore": 0.85 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 500000 }]
      }
    }
  }
}
